# ============================================================================
# KaukaMed — front-end (Next.js)
# Copie este arquivo para apps/web/.env.local e ajuste os valores:
#   cp apps/web/.env.example apps/web/.env.local
#
# O Next.js carrega os arquivos nesta ordem de prioridade:
#   .env.<ambiente>.local  ->  .env.local  ->  .env.<ambiente>  ->  .env
# (ambiente = development em `npm run dev` e production em `npm run build`).
#
# Somente variáveis com o prefixo NEXT_PUBLIC_ ficam disponíveis no navegador —
# nunca coloque segredos nelas.
# ============================================================================

# --- Aplicação --------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=KaukaMed

# URL base da API REST consumida pelo front-end
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
