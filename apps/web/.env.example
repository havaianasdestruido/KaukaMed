# ============================================================================
# KaukaMed / OdontoAura — front-end (Vite + React)
# Copie este arquivo para apps/web/.env.local e ajuste os valores:
#   cp apps/web/.env.example apps/web/.env.local
#
# O Vite carrega os arquivos nesta ordem de prioridade:
#   .env.<modo>.local -> .env.local -> .env.<modo> -> .env
# (modo = development em `npm run dev` e production em `npm run build`).
#
# ⚠️  Somente variáveis com o prefixo VITE_ são expostas ao navegador — elas
#     ficam embutidas no bundle JavaScript. NUNCA coloque segredos aqui
#     (use apenas a `anon key` pública do Supabase, protegida por RLS).
# ============================================================================

# --- Aplicação --------------------------------------------------------------
VITE_APP_NAME=OdontoAura

# --- Backend (Supabase) -----------------------------------------------------
# URL do projeto e chave pública `anon`. Sem elas o front-end roda em
# "modo demonstração", usando o dataset local em src/data/mockData.ts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- API REST (NestJS) ------------------------------------------------------
# Usada apenas para o health-check/info da API (apps/api). Opcional.
VITE_API_URL=http://localhost:3333/api/v1

# --- Build / hospedagem -----------------------------------------------------
# Base pública dos assets. Para GitHub Pages use /<nome-do-repositorio>/
# (ex.: /KaukaMed/). Para hospedagem na raiz, deixe como /.
VITE_BASE_PATH=/

# Portas dos servidores de desenvolvimento e de preview.
VITE_DEV_PORT=3000
VITE_PREVIEW_PORT=4173
