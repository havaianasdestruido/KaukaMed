# ============================================================================
# KaukaMed — API (NestJS)
# Copie este arquivo para apps/api/.env e ajuste os valores do seu ambiente:
#   cp apps/api/.env.example apps/api/.env
#
# O ConfigModule carrega os arquivos na seguinte ordem de prioridade
# (o primeiro valor encontrado vence):
#   .env.<NODE_ENV>.local  ->  .env.local  ->  .env.<NODE_ENV>  ->  .env
# Assim, dá para versionar valores padrão em .env e sobrescrever localmente
# com .env.development.local (ignorado pelo Git).
#
# Todas as variáveis são validadas no bootstrap por src/config/env.validation.ts.
# ============================================================================

# --- Aplicação --------------------------------------------------------------
# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# --- Banco de dados e cache (Phase 1) ---------------------------------------
# Valores padrão iguais aos do Docker Compose da raiz (npm run infra:up)
DATABASE_URL=postgresql://kaukamed:kaukamed@localhost:5432/kaukamed?schema=public
REDIS_URL=redis://localhost:6379
