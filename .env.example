# ============================================================================
# KaukaMed — variáveis do ambiente de desenvolvimento (raiz do monorepo)
# Usadas pelo Docker Compose (PostgreSQL e Redis) e pelos scripts da raiz:
#   cp .env.example .env
#
# As variáveis da API e do front-end ficam em apps/api/.env e apps/web/.env.local
# (veja os respectivos .env.example).
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=kaukamed
POSTGRES_PASSWORD=kaukamed
POSTGRES_DB=kaukamed
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379
REDIS_HOST=localhost
